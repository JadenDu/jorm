# 统一换行符为 LF,避免 Linux/macOS 贡献者遇到 CRLF 噪音
* text=auto eol=lf

# 源文件显式统一为文本并按 LF 规范化
*.java     text eol=lf
*.html     text eol=lf
*.js       text eol=lf
*.ts       text eol=lf
*.css      text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.xml      text eol=lf
*.json     text eol=lf
*.sql      text eol=lf
*.properties text eol=lf
*.factories text eol=lf
*.imports    text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
LICENSE        text eol=lf
CONTRIBUTING.md text eol=lf
CHANGELOG.md    text eol=lf
CODE_OF_CONDUCT.md text eol=lf
SECURITY.md     text eol=lf
MAINTAINERS.md  text eol=lf

# 二进制文件不进行换行符转换,也不做文本 diff
*.gif  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.pdf  binary
*.jar  binary
*.class binary
*.so   binary
*.dll  binary
*.dylib binary

# Linguist 调整: 让 GitHub 的 blame/PR 差异显示更准确
*.xml linguist-detectable=true
pom.xml linguist-language=XML
*.sql linguist-detectable=true

# `git archive` 打包时排除这些文件,保持发布包精简
.github export-ignore
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore