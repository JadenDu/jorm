<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

  <!-- 反射辅助类有意通过反射访问实体字段。
       我们接受由此带来的可见性影响,这是已记录的设计。 -->
  <Match>
    <Class name="io.github.jadendu.util.EntityHelper"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP,DP_DO_INSIDE_DO_PRIVILEGED"/>
  </Match>

  <Match>
    <Class name="io.github.jadendu.util.ResultSetMapper"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>

  <!-- Builder / Session 类是有意设计的有状态可链式辅助类。返回 session
       本身是流式 API 的约定;内部 Connection 引用按设计共享。 -->
  <Match>
    <Class name="~io\.github\.jadendu\.(session|sqlBuilder)\..*"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!-- 对生成字段的访问是有意为之: 唯一的使用方是
       ResultSetMapper::persistentFieldFor。 -->
  <Match>
    <Bug code="UWF"/>
  </Match>

  <!-- 内部不使用同步规避模式。 -->
  <Match>
    <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
  </Match>

  <!-- Session 的 PascalCase 可链式方法 (Where / Find / Save / Update /
       Delete / Set / Model / Select / Having / Group / Order / Limit)
       将在 3.0 移除,现已弃用。我们知道它们不符合 Java 命名规范;
       在 2.x 弃用期内予以抑制。 -->
  <Match>
    <Class name="~io\.github\.jadendu\.session\..*"/>
    <Bug pattern="NM_METHOD_NAMING_CONVENTION"/>
  </Match>

  <!-- findStream 返回的 Stream 通过 Stream.onClose(...) 关闭。
       SpotBugs 的数据流分析无法追踪 onClose 的间接调用。 -->
  <Match>
    <Class name="io.github.jadendu.session.FindSession"/>
    <Method name="findStream"/>
    <Bug pattern="OBL_UNSATISFIED_OBLIGATION"/>
  </Match>

  <!-- BaseSession 的自动管理构造器会抛出 JormException 以拒绝无效状态。
       与静默继续运行直至状态损坏相比,构造器抛异常是较小的代价。 -->
  <Match>
    <Class name="io.github.jadendu.session.base.BaseSession"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>

  <!-- Jorm.setDataSource 有意将调用方的 DataSource 存入
       静态 volatile 字段。这是已记录的单例契约。 -->
  <Match>
    <Class name="io.github.jadendu.session.factory.Jorm"/>
    <Bug pattern="EI_EXPOSE_STATIC_REP2,MS_SHOULD_BE_FINAL,MS_CANNOT_BE_FINAL,MS_EXPOSE_REP"/>
  </Match>

  <!-- CacheManager + StatisticsRegistry 是进程级单例持有者,
       返回可变的统计对象。这是已记录的全局访问设计。 -->
  <Match>
    <Class name="io.github.jadendu.cache.CacheManager"/>
    <Bug pattern="EI_EXPOSE_STATIC_REP2,MS_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="io.github.jadendu.metrics.StatisticsRegistry"/>
    <Bug pattern="MS_EXPOSE_REP,MS_SHOULD_BE_FINAL"/>
  </Match>
  <Match>
    <Class name="io.github.jadendu.cache.MeasuringSecondLevelCache"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>

  <!-- ColumnMapping.field(): Field 句柄被反射调用方 (builders/mappers)
       用于填充实体实例。 -->
  <Match>
    <Class name="io.github.jadendu.entity.ColumnMapping"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>

  <!-- Page.content()/Sort.orders() 在构造器中用
       Collections.unmodifiableList 包装传入的列表。SpotBugs 无法
       跨构造过程识别出不可修改的边界。 -->
  <Match>
    <Class name="io.github.jadendu.query.Page"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="io.github.jadendu.query.Sort"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>

  <!-- starter 侧的 Spring Bean 通过构造器注入装配属性/模板引用。
       Spring 管理的 Bean 在构造完成后不会对外发布。 -->
  <Match>
    <Class name="io.github.jadendu.autoconfigure.JormAutoConfiguration"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="io.github.jadendu.cache.redis.RedisSecondLevelCache"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

</FindBugsFilter>