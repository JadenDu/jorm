# EditorConfig 配置文件: https://editorconfig.org
# 让项目在不同编辑器和操作系统下保持一致。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,mdx}]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.{xml,pom}]
indent_size = 4

[*.properties]
indent_size = 2

[Makefile]
indent_style = tab